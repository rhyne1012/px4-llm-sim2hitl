int CheckErrors() { int n=GetNumTotalErrors(); while(GetNumTotalErrors()>0) { ErrorObj e=PopLastError(); Print(e.GetErrorString()); } return n; }
int main() {
ClearVSPModel();
// Start with an empty model.
if(CheckErrors()!=0) return 1;
array<double> wy={0,0.27,0.335,0.4,0.42,0.46,0.5,0.52,0.57,0.67}; array<double> wc={0.198,0.193,0.19,0.185,0.181,0.17,0.16,0.155,0.126,0.022}; array<double> wx={0,0.004,0.008,0.013,0.017,0.028,0.038,0.043,0.072,0.176};
string w=AddGeom("WING",""); SetGeomName(w,"Wing"); for(int i=0;i<int(wy.size())-2;i++){InsertXSec(w,1,XS_FOUR_SERIES);} Update(); for(int i=1;i<int(wy.size());i++){SetDriverGroup(w,i,SPAN_WSECT_DRIVER,ROOTC_WSECT_DRIVER,TIPC_WSECT_DRIVER); string g="XSec_"+i; double dy=wy[i]-wy[i-1]; SetParmVal(w,"Span",g,dy); SetParmVal(w,"Root_Chord",g,wc[i-1]); SetParmVal(w,"Tip_Chord",g,wc[i]); SetParmVal(w,"Sweep_Location",g,0.0); SetParmVal(w,"Sweep",g,atan((wx[i]-wx[i-1])/dy)*180.0/3.14159265358979); SetParmVal(w,"Dihedral",g,0.0); SetParmVal(w,"Twist",g,0.0); int n=int(dy/0.0125)+3; SetParmVal(w,"SectTess_U",g,n); Update();}
string sw=GetXSecSurf(w,0); for(int i=0;i<int(wy.size());i++){ChangeXSecShape(sw,i,XS_FOUR_SERIES); string xs=GetXSec(sw,i); SetParmVal(GetXSecParm(xs,"Camber"),0.02); SetParmVal(GetXSecParm(xs,"CamberLoc"),0.4); SetParmVal(GetXSecParm(xs,"ThickChord"),0.10);} SetParmVal(w,"Tess_W","Shape",25); Update();
array<double> ty={0,0.13,0.157,0.165,0.173,0.19,0.2,0.224,0.238}; array<double> tc={0.107,0.1,0.096,0.0935,0.091,0.084,0.08,0.063,0.03}; array<double> tx={0,0,0.003,0.004,0.005,0.012,0.02,0.037,0.08};
string t=AddGeom("WING",""); SetGeomName(t,"HTail"); SetParmVal(t,"X_Rel_Location","XForm",0.554); SetParmVal(t,"Z_Rel_Location","XForm",-0.045); for(int i=0;i<int(ty.size())-2;i++){InsertXSec(t,1,XS_FOUR_SERIES);} Update(); for(int i=1;i<int(ty.size());i++){SetDriverGroup(t,i,SPAN_WSECT_DRIVER,ROOTC_WSECT_DRIVER,TIPC_WSECT_DRIVER); string g="XSec_"+i; double dy=ty[i]-ty[i-1]; SetParmVal(t,"Span",g,dy); SetParmVal(t,"Root_Chord",g,tc[i-1]); SetParmVal(t,"Tip_Chord",g,tc[i]); SetParmVal(t,"Sweep_Location",g,0.0); SetParmVal(t,"Sweep",g,atan((tx[i]-tx[i-1])/dy)*180.0/3.14159265358979); SetParmVal(t,"Dihedral",g,0.0); SetParmVal(t,"Twist",g,0.0); int n=int(dy/0.01)+3; SetParmVal(t,"SectTess_U",g,n); Update();}
string st=GetXSecSurf(t,0); for(int i=0;i<int(ty.size());i++){ChangeXSecShape(st,i,XS_FOUR_SERIES); string xs=GetXSec(st,i); SetParmVal(GetXSecParm(xs,"Camber"),0.0); SetParmVal(GetXSecParm(xs,"ThickChord"),0.13);} SetParmVal(t,"Tess_W","Shape",25); Update();
array<double> fz={0,0.007,0.026,0.068,0.097,0.125,0.157,0.176}; array<double> fc={0.123,0.109,0.125,0.12,0.104,0.089,0.064,0.004}; array<double> fx={0,0.014,0.027,0.031,0.047,0.061,0.086,0.15};
string f=AddGeom("WING",""); SetGeomName(f,"Fin"); SetParmVal(f,"Sym_Planar_Flag","Sym",0); SetParmVal(f,"X_Rel_Location","XForm",0.51); SetParmVal(f,"Z_Rel_Location","XForm",-0.045); SetParmVal(f,"X_Rel_Rotation","XForm",90.0); for(int i=0;i<int(fz.size())-2;i++){InsertXSec(f,1,XS_FOUR_SERIES);} Update(); for(int i=1;i<int(fz.size());i++){SetDriverGroup(f,i,SPAN_WSECT_DRIVER,ROOTC_WSECT_DRIVER,TIPC_WSECT_DRIVER); string g="XSec_"+i; double dy=fz[i]-fz[i-1]; SetParmVal(f,"Span",g,dy); SetParmVal(f,"Root_Chord",g,fc[i-1]); SetParmVal(f,"Tip_Chord",g,fc[i]); SetParmVal(f,"Sweep_Location",g,0.0); SetParmVal(f,"Sweep",g,atan((fx[i]-fx[i-1])/dy)*180.0/3.14159265358979); SetParmVal(f,"Dihedral",g,0.0); SetParmVal(f,"Twist",g,0.0); int n=int(dy/0.012)+3; SetParmVal(f,"SectTess_U",g,n); Update();}
string sf=GetXSecSurf(f,0); for(int i=0;i<int(fz.size());i++){ChangeXSecShape(sf,i,XS_FOUR_SERIES); string xs=GetXSec(sf,i); SetParmVal(GetXSecParm(xs,"Camber"),0.0); SetParmVal(GetXSecParm(xs,"ThickChord"),0.10);} SetParmVal(f,"Tess_W","Shape",21); Update();
Update();
if(CheckErrors()!=0) return 2;
Print("OPENVSP_VERSION:"+GetVSPVersion());
SetVSP3FileName("/tmp/claude-1000/-home-rhyne-dynabook-Developer-SkySurfer/da089a45-295e-4015-8da9-b51365cddf29/scratchpad/vsp/skysurfer_xcheck-c5sxe3nj/skysurfer_xcheck.vsp3");
WriteVSPFile("/tmp/claude-1000/-home-rhyne-dynabook-Developer-SkySurfer/da089a45-295e-4015-8da9-b51365cddf29/scratchpad/vsp/skysurfer_xcheck-c5sxe3nj/skysurfer_xcheck.vsp3",SET_ALL);
if(CheckErrors()!=0) return 3;
Print("OPENVSP_MCP_SUCCESS_00beb059b86f4a8e962fbeb1bf4bedf3");
return 0;
